# Les paquets @forestar-be sont publiés sur GitHub Packages (dépôt privé).
#
# Le jeton n'est jamais versionné :
#   - en local  : ~/.npmrc avec //npm.pkg.github.com/:_authToken=<PAT read:packages>
#   - sur Vercel : variable d'environnement NPM_RC contenant les deux lignes,
#     jeton compris (Vercel écrit ce contenu dans un .npmrc avant l'install)
@forestar-be:registry=https://npm.pkg.github.com
